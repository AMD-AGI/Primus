# Pinned versions for the SpecForge ROCm runtime image.
# Override any ARG when invoking docker build.

# Official SGLang ROCm image. Tag is baked for gfx950 (MI355X / MI350X).
# For MI300X (gfx942) override BASE_IMAGE to an mi30x tag that still ships AITER
# and the speculative algorithm you will serve (validated recipe uses v0.5.14).
BASE_IMAGE=lmsysorg/sglang:v0.5.14-rocm700-mi35x@sha256:f1d38fd8076e69fdd103858149f9953a936cf9b322b2aa2cc97b08474d9a3623

# SpecForge git commit SHA (not a moving branch).
SPECFORGE_REF=ec0988d527c828a24b8a5d639857f676e6e7f575

# Local image tag. Build from the Primus repository root:
#   docker build -f examples/specforge/docker/Dockerfile -t primus-specforge:v0.5.14-rocm700-mi35x .
RUNTIME_IMAGE=primus-specforge:v0.5.14-rocm700-mi35x
