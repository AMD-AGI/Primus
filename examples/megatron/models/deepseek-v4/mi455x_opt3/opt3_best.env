# DeepSeek-V4 Flash proxy, 1x MI455X (gfx1250): best measured configuration of branch yyq/opt3-int (2026-11-21).
# ~48.4 ms/iter with --cuda_graph_impl full_iteration (int A/B 2026-11-22, + membound)
# Paper recipe: FP8 E4M3, 128x128 weight / 1x128 activation blocks, UE8M0 scales; BF16 for embedding/lm_head/router/norm/attention core.
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# ---- base: Turbo-native 128-block FP8 path (no Transformer Engine fp8) ----
export PRIMUS_TURBO_FP8_BLOCK=1
export PRIMUS_TURBO_FP8_BLOCK_UE8M0=1
export PRIMUS_TURBO_FP8_BLOCK_KERNEL=dsv4up         # dense FP8 GEMM: Gluon dsv4up (needs Triton main), g90 fallback per shape
export PRIMUS_FUSED_ADAM_CLIP=1 PRIMUS_FUSED_ADAM_BF16_GRAD=1 PRIMUS_FUSED_ADAM_BF16_WRITEBACK=1
export PRIMUS_DSA_GFX1250_TURBO=1

# ---- MoE experts: fused MegaMoE with 128-block FP8 experts (EP=1); also pass --turbo_mega_moe_precision fp8_block ----
export USE_TURBO_MEGA_MOE=True
export PRIMUS_TURBO_MOE_FP8BLK_WGRAD=${PRIMUS_TURBO_MOE_FP8BLK_WGRAD:-vkp}  # persistent vkpblk wgrad, longest-expert-first; wgrad line: vkq (same bits, scale planes on VMEM, -13% per call)
export PRIMUS_TURBO_MOE_FP8BLK_GG=${PRIMUS_TURBO_MOE_FP8BLK_GG:-mxp}               # mxgemm: mxgk = k256's TDM traffic + a fragment pipeline across k-tiles (bit-identical; in-step -7% on the grouped fwd/dgrad GEMMs, -0.28 ms/step; k256 = moegemm's flygg, -0.57 ms)
# moegemm2: vkp wgrad sched2 (scalar tile params, batched/carried E8M0 words, A fragments read ahead; bit-identical C
# and sumsq partials; kernel -7%). PRIMUS_TURBO_MOE_FP8BLK_GG=k256p selects the persistent k256 flygg (ggk). Default off.
export PRIMUS_TURBO_MOE_FP8BLK_VKP_SCHED2=${PRIMUS_TURBO_MOE_FP8BLK_VKP_SCHED2:-1}

# ---- opt3 switches (e2e leave-one-out gains in README.md) ----
export PRIMUS_V4_ROUTER_FUSED=1
export PRIMUS_INDEXER_GLUON=1 PRIMUS_INDEXER_GLUON_SAVE_DOT=0   # no effect when the indexer is disabled (proxy default)
export PRIMUS_WGRAD_BETA0=1
export PRIMUS_TURBO_G90_WGRAD_FUSE=1
export PRIMUS_V4_QKV_A_CONCAT=1
export PRIMUS_FP8BLK_ADAM_QUANT=1                   # Adam writes FP8 W / W^T / UE8M0 scales (dense weights)
export PRIMUS_FP8BLK_ADAM_MEGAMOE=1                # ... and the MegaMoE fp8_block expert caches; skips the _w_128x128 re-quant (-0.3 ms)
# adamfast: SKIP_BF16=1 -> the tile Adam no longer stores the BF16 MegaMoE expert weights (2 of 22 B/param); they are
#   rebuilt from the fp32 master before any BF16 reader (cache refresh, save_checkpoint, params norm, DP hash check).
#   e2e 3 pairs 58.12 -> 57.27 ms (-0.85), bit-identical, checkpoint byte-identical. Off by default (track rule).
export PRIMUS_FP8BLK_ADAM_SKIP_BF16=${PRIMUS_FP8BLK_ADAM_SKIP_BF16:-1}
# adamattn: WAVEDENSE=1 -> v10 tile Adam kernel (whole-wave contiguous row accesses, compile-time BF16 store, LDS-only
#   barriers): MegaMoE expert tiles -10% in the kernel microbench, outputs bit-identical. 0 = the previous v9 kernel source.
export PRIMUS_FP8BLK_ADAM_WAVEDENSE=${PRIMUS_FP8BLK_ADAM_WAVEDENSE:-1}
export PRIMUS_V4_FUSED_CE=1
export PRIMUS_HC_FUSED=1 PRIMUS_HC_FOLD_NORM=1 PRIMUS_HC_BIF=0
# hc track (~/dsv41/work/hc/REPORT.md; all bit-identical, default off here, recommended values in brackets):
#   (config C on by default; set a tile var to an empty value to get the old default tile)
#   PRIMUS_HC_EXPAND_TILE [1,2048,8]: expand fwd tile; the bm16/bd128 default goes through LDS under Triton main (68.8 -> 24 us)
#   PRIMUS_HC_POST_TILE [1,1]: expand bwd (B1) tile (49 -> 35 us); PRIMUS_HC_NOCAST [1]: no torch casts of fn.weight/scale/base
#   PRIMUS_HC_B3_VAR [1,0]: B3 keeps W^T in LDS (326 -> 226 VGPRs, 123 -> 109 us)
#   PRIMUS_HC_HEAD_FUSED [1]: HyperHead collapse fwd/bwd in Triton (=2: one-pass dpre, reorders a sum, loss outside spread)
#   PRIMUS_HC_LIFT_FUSED [1]: embedding -> 4-stream copy and its backward sum in Triton
#   PRIMUS_HC_RMSLIN_TUNED [1]: HyperHead rms-linear fwd/bwd retune (124 -> 77 us bwd)
export PRIMUS_HC_EXPAND_TILE=${PRIMUS_HC_EXPAND_TILE-1,2048,8} PRIMUS_HC_POST_TILE=${PRIMUS_HC_POST_TILE-1,1}
export PRIMUS_HC_NOCAST=${PRIMUS_HC_NOCAST:-1} PRIMUS_HC_B3_VAR=${PRIMUS_HC_B3_VAR-1,0}
export PRIMUS_HC_HEAD_FUSED=${PRIMUS_HC_HEAD_FUSED:-1} PRIMUS_HC_LIFT_FUSED=${PRIMUS_HC_LIFT_FUSED:-1}
export PRIMUS_HC_RMSLIN_TUNED=${PRIMUS_HC_RMSLIN_TUNED:-0}
# fuse-hc (~/dsv41/work/fusehc/REPORT.md; all bit-identical, byte-equal in test_fusehc.py):
#   GRAD_DIRECT: HC backward tail (dW split-K reduce, dscale/dbase sums, folded-norm dgamma reduce) in one launch,
#     written straight into main_grad (drops _hc_reduce, _rms_dg_reduce, 3 casts and the DDP hook copies per HC).
#   B3X: HC B3 (dx + dW) with the 4 streams in one program (x / dnew / dcollapsed read once per tile); bf16 W read
#     directly. B3X_CFG="bc=64,w=8,bt=32" (default; w=4: 89 us, the production _hc_b3_gl 110 us, microbench).
#   XRMS: expand(L) also computes HC(L+1)'s rms-linear partials (drops _hc_fwd_wmma3; with B3X also _hc_wt_split).
export PRIMUS_HC_GRAD_DIRECT=${PRIMUS_HC_GRAD_DIRECT:-1} PRIMUS_HC_B3X=${PRIMUS_HC_B3X:-1} PRIMUS_HC_XRMS=${PRIMUS_HC_XRMS:-1}
export PRIMUS_GRAD_NORM_FROM_NAN_CHECK=1
# fuseq (track fuseq; bit-identical, -1.4 ms together): quant scales in GEMM layout, RoPE bwd in place,
# o_a dW and embedding dW straight into main_grad, router post without zero fills. Overridable from outside.
export PRIMUS_TURBO_FUSEQ=${PRIMUS_TURBO_FUSEQ:-1}
export PRIMUS_V4_ROPE_BWD_INPLACE=${PRIMUS_V4_ROPE_BWD_INPLACE:-1}
export PRIMUS_V4_OA_MAIN_GRAD=${PRIMUS_V4_OA_MAIN_GRAD:-1}
export PRIMUS_V4_ROUTER_DENSE_OUT=${PRIMUS_V4_ROUTER_DENSE_OUT:-1}
export PRIMUS_EMB_MAIN_GRAD=${PRIMUS_EMB_MAIN_GRAD:-1}                     # TP=1 only; falls back otherwise
# bubble (track bubble; bit-identical, -1.25 ms): step-end logging lags one step and runs host-only, so the GPU no
# longer drains between steps (world size 1 only, flushes on last/eval/save/exit); skip no-op DP=1 param all-gathers.
export PRIMUS_BUBBLE_LAG_LOG=${PRIMUS_BUBBLE_LAG_LOG:-1}
export PRIMUS_BUBBLE_SKIP_DP1_AG=${PRIMUS_BUBBLE_SKIP_DP1_AG:-1}
# wgsmall (track wgsmall; ~/dsv41/work/wgsmall/REPORT.md). Overridable from outside.
# MOE_WGRAD_SUMSQ: the grad-norm sum of squares of the MegaMoE expert grads comes from the vkp wgrad epilogue, so the
#   norm pass no longer re-reads them (-0.9 ms; grad norm differs by fp32 summation order only). =0 turns it off.
export PRIMUS_TURBO_MOE_WGRAD_SUMSQ=${PRIMUS_TURBO_MOE_WGRAD_SUMSQ:-1}
# DSV4UP_PREFER_G90 empty: every dsv4up-supported dense pass on dsv4up (the code default keeps three passes on g90;
#   fc2 wgrad 36 -> 24 us; bit-identical; -0.2 ms). The ${X-} form keeps an explicit value, including the code default
#   list "fwd:4096x1024x4096,wgrad:1024x4096x4096,wgrad:4096x2048x4096" to restore the old behaviour.
export PRIMUS_TURBO_DSV4UP_PREFER_G90=${PRIMUS_TURBO_DSV4UP_PREFER_G90-}
# Available, not enabled: PRIMUS_TURBO_DSV4UP_SPLITK=4096x1024x32768:4 (wq_b dgrad on dsv4up split-K 4 + fused reduce,
#   -0.35 ms, but loss@20 9.867496 with the two switches above, just below the 9.868-9.872 gate).
# Not enabled: PRIMUS_TURBO_WQB_SPLITK (g90 split-K; numerically fine -- the 12:02 NaN run had a corrupted iteration-1
#   forward, the rare nondeterministic failure -- but slower than dsv4up split-K), PRIMUS_TURBO_MOE_GG_DSV4 (no gain).

# glue (track glue; ~/dsv41/work/glue/REPORT.md). Default off here; overridable from outside.
# RMSNORM: LocalRMSNorm bwd without fp32 atomics (per-program dw partials + fixed-order reduce; deterministic, dw
#   bits differ from the nondeterministic atomic order) and norm dgamma straight into main_grad (rmsnorm_g90 too).
# ROPE_NOCAST: rope kernels read int64 positions / bf16 inv_freq directly (bit-identical, -2 casts per rope call).
# COMPRESS_POOL: compressor window split + overlap stitch folded into the pool kernels (bit-identical).
# WQB_DYQ: q norm/rope backward emits the wq_b dY FP8 copies (Turbo DyPrequantSlot), no separate dY quant
#   (bit-identical; needs PRIMUS_TURBO_FUSEQ=1).
export PRIMUS_GLUE_RMSNORM=${PRIMUS_GLUE_RMSNORM:-1}
export PRIMUS_GLUE_ROPE_NOCAST=${PRIMUS_GLUE_ROPE_NOCAST:-1}
export PRIMUS_GLUE_COMPRESS_POOL=${PRIMUS_GLUE_COMPRESS_POOL:-1}
export PRIMUS_GLUE_WQB_DYQ=${PRIMUS_GLUE_WQB_DYQ:-0}
# EMB_TOUCHED: embedding main_grad clear limited to the rows the previous step wrote (needs one embedding grad write
#   per step; raises otherwise; bit-identical). SMALLS: router fused fn builds no zero grads for its index outputs.
export PRIMUS_GLUE_EMB_TOUCHED=${PRIMUS_GLUE_EMB_TOUCHED:-1}
export PRIMUS_GLUE_SMALLS=${PRIMUS_GLUE_SMALLS:-1}

# ---- fuse track (fuse-moe; all default off) ----
# FUSE_ROUTE: MegaMoE fp8_block EP=1 routing straight from the fused router GEMM through one compact route kernel
#   (top-k weights in V4RouterPostFn's expressions and layout, descending order, force-LB even slots, sequence-balance
#   loss partials) + one loss kernel; backward one kernel. Replaces ~55 kernels/layer of dense probs / routing_map /
#   topk / scatter / seq-loss torch ops. Forward bit-identical; d logits bit-identical for hash layers, the seq-loss
#   term of learned layers differs by fp32 summation order (~1e-15 abs). Needs PRIMUS_V4_ROUTER_FUSED=1.
export PRIMUS_FUSE_ROUTE=${PRIMUS_FUSE_ROUTE:-1}
# FUSE_MOE_BWD (Turbo): MegaMoE backward d topk_weights in one launch from the unsummed SwiGLU-bwd partials (torch's
#   pairwise order) and the LPT expert order in one launch; bit-identical.
export PRIMUS_FUSE_MOE_BWD=${PRIMUS_FUSE_MOE_BWD:-1}
# FUSE_MOE_ADD (with FUSE_ROUTE): the shared expert runs first and the routed + shared add happens inside the MegaMoE
#   combine kernel (one bf16 [T, H] add kernel less per layer; bit-identical).
export PRIMUS_FUSE_MOE_ADD=${PRIMUS_FUSE_MOE_ADD:-1}
# FUSE_MOE_SWB_TDM (Turbo): MegaMoE SwiGLU backward + dual quant as a TDM-streamed Gluon kernel (byte-identical;
#   kernel 131 -> 119 us, ~-0.1 ms/step predicted, e2e not yet confirmed). Needs Triton main (gluon cdna5).
export PRIMUS_FUSE_MOE_SWB_TDM=${PRIMUS_FUSE_MOE_SWB_TDM:-1}

# ---- hipBLASLt TunableOp (device ordinal is inserted: _0) ----
# tunableop_dsv4_gfx1250_bf16_0.csv (bf16gemm track, default): the opt3 entries (lm_head fwd/dgrad, o_a bmm fwd/dgrad)
#   + o_a dgrad TN + lm_head wgrad TN (the two layout switches below) + indexer 128->8192 + Hadamard rotate_queries.
# tunableop_dsv4_gfx1250_bf16all_0.csv: + compressor / indexer small shapes (another ~0.1 ms; numerics change, loss@20
#   9.8653 just below the 9.868-9.872 spread, so not the default). tunableop_dsv4_gfx1250_0.csv: the opt3 file.
export PYTORCH_TUNABLEOP_ENABLED=1 PYTORCH_TUNABLEOP_TUNING=0
export PYTORCH_TUNABLEOP_FILENAME=${PRIMUS_DSV4_TUNABLEOP_FILENAME:-$HERE/tunableop_dsv4_gfx1250_bf16_.csv}

# ---- BF16 GEMM layouts (bf16gemm track; need the bf16 TunableOp file above), e2e 62.16 -> 61.40 ms ----
# lm_head wgrad: apex wgrad_gemm_accum_fp16 (NT, 1.90 ms, invisible to TunableOp) -> torch mm into main_grad (beta 0 with
#   PRIMUS_WGRAD_BETA0) on Triton-transposed operands (TN, 1.35 ms + 0.13 ms transposes). LAYOUT=nt keeps the training
#   layout (bit-identical to apex). o_a dgrad: bmm TN on a Triton-transposed w (8 x 142 -> 8 x 117+11 us, bit-identical).
export PRIMUS_LM_HEAD_WGRAD_TORCH=${PRIMUS_LM_HEAD_WGRAD_TORCH:-1} PRIMUS_LM_HEAD_WGRAD_LAYOUT=${PRIMUS_LM_HEAD_WGRAD_LAYOUT:-tn}
export PRIMUS_V4_OA_DGRAD_TN=${PRIMUS_V4_OA_DGRAD_TN:-1}

# ---- Triton: image Triton 3.8.0+git669b31ac miscompiles async LDS copies with expert scheduling on ----
export TRITON_HIP_USE_EXPERT_SCHEDULING=0
# densefp8: wq_a||wkv concat on the block-FP8 dsv4up path (needs PRIMUS_V4_QKV_A_CONCAT=1): one x quant, one launch per
# pass against the joint FP8 weight the optimizer writes, fused main_grad wgrad. fwd/wgrad bit-identical, dgrad fp32 over
# K=1536 (more accurate; loss@20 9.871798, gnorm 4.159, in the spread). e2e A/B -0.2 / -0.55 ms (dfp8_cat2*). Off by default.
export PRIMUS_V4_QKV_A_CONCAT_FP8BLK=${PRIMUS_V4_QKV_A_CONCAT_FP8BLK:-1}
# densefp8: each dense Linear's dsv4up dgrad + wgrad in ONE launch (bit-identical). Kernel bench -30 us on wq_b, but in-step
# the dual kernel runs slower than two launches (fc1/fc2/wo_b +12..19 us each): e2e +0.3 ms. Keep OFF.
export PRIMUS_TURBO_DSV4UP_DUAL=${PRIMUS_TURBO_DSV4UP_DUAL:-0}
# densefp8: dsv4up double-buffered epilogue (bit-identical; -0.1..-2.5 us per GEMM in isolation, not e2e-tested). Off.
export PRIMUS_TURBO_DSV4UP_EPI2=${PRIMUS_TURBO_DSV4UP_EPI2:-1}
# densegemm: SMALLTILE runs the listed dsv4up GEMMs ("MxNxK[a]:tile", a = the beta-1 accumulate call) on the dsv4s
#   smaller-output-tile kernel (Turbo gluon/gemm/dsv4s_gemm.py); bit-identical (same per-output K order / WMMA chain).
#   Also applies to the CONCAT_SPLIT_EPI split GEMMs. Proposed value (densegemm REPORT; e2e with EPI2 + CE_BWD_GT
#   49.85 -> 49.47 ms, 3 pairs, bit-identical):
#   4096x1024x32768:256x128s3,4096x1536x4096:256x128s3,1536x4096x4096:256x128s3,1536x4096x4096a:256x128s3
#   (wq_b dgrad 64 -> 128 tiles, in-step 98.6 -> 74.8 us; wq_a||wkv split fwd / wgrad -2.2 / -1.5 us). Shared fc2
#   (4096x2048x4096) measured neutral in-step (dgrad +0.9, wgrad -0.7): left out. Default off.
export PRIMUS_TURBO_DSV4UP_SMALLTILE=${PRIMUS_TURBO_DSV4UP_SMALLTILE-4096x1024x32768:256x128s3,4096x1536x4096:256x128s3,1536x4096x4096:256x128s3,1536x4096x4096a:256x128s3}
# densegemm: CE_BWD_GT=1 -> the fused-CE backward also writes dlogits^T (tiled kernel, same values bit for bit) and the
#   lm_head TN wgrad uses it instead of the 120 us Triton transpose (needs LM_HEAD_WGRAD_TORCH=1, LAYOUT=tn).
#   CE bwd + transpose 282 -> 215 us. Default off.
export PRIMUS_V4_CE_BWD_GT=${PRIMUS_V4_CE_BWD_GT:-1}

# ---- fuseattn (track fuse-attn; ~/dsv41/work/fuseattn/REPORT.md). Default off here; overridable from outside. ----
# OROPE_INPLACE: inverse RoPE of the attention output in place on its 64-column rotary tail (the original tail is kept
#   and restored in the backward, so the sparse-MLA backward reads its own bytes); bit-identical, 1/8 of the traffic.
export PRIMUS_V4_OROPE_INPLACE=${PRIMUS_V4_OROPE_INPLACE:-1}
# CONCAT_SPLIT_EPI: wq_a||wkv forward and the two-weight wgrad as ONE dsv4up GEMM with the split-output epilogue (each
#   256-tile stored into its own output / main_grad) instead of the dual kernel; bit-identical.
export PRIMUS_TURBO_CONCAT_SPLIT_EPI=${PRIMUS_TURBO_CONCAT_SPLIT_EPI:-1}
# INDEXER_TOPK_TRITON: CSA indexer torch.topk (sorted) + its -inf -> -1 sentinel (11 launches) as one Triton tl.sort per
#   row; same values / indices bit for bit (torch's key order and tie order); only P in [1024, 4096] and no-grad scores.
export PRIMUS_V4_INDEXER_TOPK_TRITON=${PRIMUS_V4_INDEXER_TOPK_TRITON:-1}
# QKV_POST_FUSED: q_layernorm + kv_layernorm + kv RoPE after the wq_a||wkv GEMM as one op (fwd 3 -> 1 launch; bwd kv RoPE
#   adjoint + both RMSNorm bwds 3 -> 1, both dgamma reduces 2 -> 1); bit-identical (PrimusTurboRMSNorm/rmsnorm_g90 only).
export PRIMUS_V4_QKV_POST_FUSED=${PRIMUS_V4_QKV_POST_FUSED:-1}

# ---- overlap (track overlap; ~/dsv41/work/overlap/ledger.md). Default off here; overridable from outside. ----
# Independent kernel chains on side streams inside the graph-captured step; same kernels, same inputs, same reduction
# orders (961/961 param / main_grad / optimizer-state fingerprints identical to the serial step). All off when the
# torch.distributed world size is > 1. Joined after every microbatch backward (patches/overlap_patches.py).
# WGRAD: dense block-FP8 Linear wgrads (dsv4up/g90 into main_grad, incl. the qkv_a concat) on a side stream.
# MOE_WGRAD: MegaMoE fp8_block expert wgrads (vkp) + LPT order on the side stream (persistent vkp holds every CU, so it
#   mostly trades places with the fc1 dgrad; ~-0.1 ms on top of the rest, within noise).
# SHARED: MoE shared expert forward (and its backward) on a side stream next to router + routed experts (ForkGrad keeps
#   the serial input-grad sum order). INDEXER: CSA indexer (forward only) on a side stream next to the q/kv path.
# COMPRESSOR: =1 HCA compressor (pool) forward + backward on a side stream next to the q/kv path; =2 also CSA (no gain).
# e2e (int 8dd935a6b/c35d8a2c, graph 20, 4 interleaved pairs): base 49.50/49.50/49.55/49.20 -> all five (COMPRESSOR=1)
#   49.15/49.10/49.05/48.85 (-0.40 ms); 100 it: 50.10 -> 49.70; bit-identical (961/961 fingerprints, 100-it loss and
#   grad-norm traces). The DEBUG_HIP_GRAPH_* executor knobs gave no extra gain, so they are not needed. With DDP grad
#   checks on (--check_for_nan_in_loss_and_grad, the eager default) all switches fall back to serial.
export PRIMUS_OVERLAP_WGRAD=${PRIMUS_OVERLAP_WGRAD:-1}
export PRIMUS_OVERLAP_MOE_WGRAD=${PRIMUS_OVERLAP_MOE_WGRAD:-1}
export PRIMUS_OVERLAP_SHARED=${PRIMUS_OVERLAP_SHARED:-1}
export PRIMUS_OVERLAP_INDEXER=${PRIMUS_OVERLAP_INDEXER:-1}
export PRIMUS_OVERLAP_COMPRESSOR=${PRIMUS_OVERLAP_COMPRESSOR:-1}
# ---- membound track (~/dsv41/work/membound/ledger.md; all default off) ----
# MB_QDUAL: dual-quant kernel per call site (key <site><N>: f = FP8 Linear fwd input, c = concat-N fwd input, b = dY).
#   The 2-warp 128x128-tile quant (474 VGPRs, 29 KB unrolled code) runs 3-5x slower when it is the first launch of
#   its code after a GEMM (in-step q_a 30 us vs 4.7 cold, shared-expert x 43 vs 12); the 8-warp variant (11 KB) does
#   not. Recommended: f1024:t2w8,f2048:t2w8,f4096:t2w8,f8192:t2w8 (byte-identical).
export PRIMUS_MB_QDUAL=${PRIMUS_MB_QDUAL-f1024:t2w8,f2048:t2w8,f4096:t2w8,f8192:t2w8}
# MB_PACKQ: the dsv4up weight-scale packing of each FP8 Linear forward runs inside the activation-quant launch
#   (40 _pack_scales launches less per step; byte-identical).
export PRIMUS_MB_PACKQ=${PRIMUS_MB_PACKQ:-1}
# MB_GNORM: grad-norm sum of squares of all bucket ranges + the MoE wgrad sumsq partials in two launches (was ~86);
#   changes the fp32 summation order of the grad norm (loss@20 in the spread).
export PRIMUS_MB_GNORM=${PRIMUS_MB_GNORM:-1}
# MB_ROPE_TBL: memoised contiguous bf16 RoPE tables for the compressor / indexer (no per-call cast/copy, indexer query
#   table once per step); bit-identical.
export PRIMUS_MB_ROPE_TBL=${PRIMUS_MB_ROPE_TBL:-1}
# MB_SMALLS: CE forward partials without fills; QKVPost backward reads strided gradients in place; bit-identical.
export PRIMUS_MB_SMALLS=${PRIMUS_MB_SMALLS:-1}
# (fuse-attn knob, bit-identical) q_norm_rope_fwd2 tile: PRIMUS_V4_QNR_FWD_BH=8 PRIMUS_V4_QNR_FWD_NW=2 (in-step 48 -> 44 us)
export PRIMUS_V4_QNR_FWD_BH=${PRIMUS_V4_QNR_FWD_BH:-8} PRIMUS_V4_QNR_FWD_NW=${PRIMUS_V4_QNR_FWD_NW:-2}
# SMLA_FWD_PIPE (attnfwd, Turbo yyq/attnfwd): the CSA top-k sparse-MLA forward runs the softmax of kv tile t inside the
#   QK WMMAs of tile t+1; o / lse byte-identical; microbench CSA fwd 211.8 -> 206.8 us (-2.4%, ~-0.016 ms/step). Off.
export PRIMUS_SMLA_FWD_PIPE=${PRIMUS_SMLA_FWD_PIPE:-0}
