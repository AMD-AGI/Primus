# DeepSeek-V4 Flash proxy, 1x MI455X (gfx1250): best measured configuration of branch yyq/opt3-int (2026-11-21).
# 62.2 ms/iter with --cuda_graph_impl full_iteration (C1 baseline on the same node: 97.0 ms). See README.md.
# Paper recipe: FP8 E4M3, 128x128 weight / 1x128 activation blocks, UE8M0 scales; BF16 for embedding/lm_head/router/norm/attention core.
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# ---- base: Turbo-native 128-block FP8 path (no Transformer Engine fp8) ----
export PRIMUS_TURBO_FP8_BLOCK=1
export PRIMUS_TURBO_FP8_BLOCK_UE8M0=1
export PRIMUS_TURBO_FP8_BLOCK_KERNEL=dsv4up         # dense FP8 GEMM: Gluon dsv4up (needs Triton main), g90 fallback per shape
export PRIMUS_FUSED_ADAM_CLIP=1 PRIMUS_FUSED_ADAM_BF16_GRAD=1 PRIMUS_FUSED_ADAM_BF16_WRITEBACK=1
export PRIMUS_DSA_GFX1250_TURBO=1

# ---- MoE experts: fused MegaMoE with 128-block FP8 experts (EP=1); also pass --turbo_mega_moe_precision fp8_block ----
export USE_TURBO_MEGA_MOE=True
export PRIMUS_TURBO_MOE_FP8BLK_WGRAD=vkp            # persistent vkpblk wgrad, longest-expert-first

# ---- opt3 switches (e2e leave-one-out gains in README.md) ----
export PRIMUS_V4_ROUTER_FUSED=1
export PRIMUS_INDEXER_GLUON=1 PRIMUS_INDEXER_GLUON_SAVE_DOT=0   # no effect when the indexer is disabled (proxy default)
export PRIMUS_WGRAD_BETA0=1
export PRIMUS_TURBO_G90_WGRAD_FUSE=1
export PRIMUS_V4_QKV_A_CONCAT=1
export PRIMUS_FP8BLK_ADAM_QUANT=1                   # Adam writes FP8 W / W^T / UE8M0 scales (dense weights)
export PRIMUS_V4_FUSED_CE=1
export PRIMUS_HC_FUSED=1 PRIMUS_HC_FOLD_NORM=1 PRIMUS_HC_BIF=0
export PRIMUS_GRAD_NORM_FROM_NAN_CHECK=1
# Not enabled: PRIMUS_TURBO_WQB_SPLITK (grad norm NaN on g90), PRIMUS_TURBO_MOE_GG_DSV4 (no gain over flygg).

# ---- hipBLASLt TunableOp (device ordinal is inserted: _0) ----
# tunableop_dsv4_gfx1250_bf16_0.csv (bf16gemm track, default): the opt3 entries (lm_head fwd/dgrad, o_a bmm fwd/dgrad)
#   + o_a dgrad TN + lm_head wgrad TN (the two layout switches below) + indexer 128->8192 + Hadamard rotate_queries.
# tunableop_dsv4_gfx1250_bf16all_0.csv: + compressor / indexer small shapes (another ~0.1 ms; numerics change, loss@20
#   9.8653 just below the 9.868-9.872 spread, so not the default). tunableop_dsv4_gfx1250_0.csv: the opt3 file.
export PYTORCH_TUNABLEOP_ENABLED=1 PYTORCH_TUNABLEOP_TUNING=0
export PYTORCH_TUNABLEOP_FILENAME=${PRIMUS_DSV4_TUNABLEOP_FILENAME:-$HERE/tunableop_dsv4_gfx1250_bf16_.csv}

# ---- BF16 GEMM layouts (bf16gemm track; need the bf16 TunableOp file above), e2e 62.16 -> 61.40 ms ----
# lm_head wgrad: apex wgrad_gemm_accum_fp16 (NT, 1.90 ms, invisible to TunableOp) -> torch mm into main_grad (beta 0 with
#   PRIMUS_WGRAD_BETA0) on Triton-transposed operands (TN, 1.35 ms + 0.13 ms transposes). LAYOUT=nt keeps the training
#   layout (bit-identical to apex). o_a dgrad: bmm TN on a Triton-transposed w (8 x 142 -> 8 x 117+11 us, bit-identical).
export PRIMUS_LM_HEAD_WGRAD_TORCH=${PRIMUS_LM_HEAD_WGRAD_TORCH:-1} PRIMUS_LM_HEAD_WGRAD_LAYOUT=${PRIMUS_LM_HEAD_WGRAD_LAYOUT:-tn}
export PRIMUS_V4_OA_DGRAD_TN=${PRIMUS_V4_OA_DGRAD_TN:-1}

# ---- Triton: image Triton 3.8.0+git669b31ac miscompiles async LDS copies with expert scheduling on ----
export TRITON_HIP_USE_EXPERT_SCHEDULING=0
