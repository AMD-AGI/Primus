# DeepSeek-V4 Flash on MI455X (gfx1250): block-FP8 recipe preset.
#
# The fused kernels and wiring of the fast path are on by default in code when the device is gfx1250
# (see primus/backends/megatron/core/dsv4_features.py); this file only selects the recipe and the
# environment that must be set before PyTorch starts.
#   PRIMUS_DSV4_FAST=0     Primus-side master off switch (upstream Primus paths run instead)
#   PRIMUS_DSV4_BITWISE=1  turn the order-changing fusions off for numerics debugging
#   PRIMUS_GLUON=0         use the non-Gluon fallbacks (Triton < 3.9 selects them automatically)
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# Paper recipe: FP8 E4M3, 128x128 weight / 1x128 activation blocks, UE8M0 scales, no Transformer Engine.
export PRIMUS_TURBO_FP8_BLOCK=1
export PRIMUS_TURBO_FP8_BLOCK_UE8M0=1
export USE_TURBO_MEGA_MOE=True

# Fused Adam with BF16 gradients / write-back (upstream switches).
export PRIMUS_FUSED_ADAM_CLIP=1 PRIMUS_FUSED_ADAM_BF16_GRAD=1 PRIMUS_FUSED_ADAM_BF16_WRITEBACK=1

# hipBLASLt TunableOp results for lm_head and the grouped o_a bmm. The CSV is tied to the hipBLASLt of the
# image; re-tune after an image change. PyTorch inserts the device ordinal into the file name (_0).
export PYTORCH_TUNABLEOP_ENABLED=1 PYTORCH_TUNABLEOP_TUNING=0
export PYTORCH_TUNABLEOP_FILENAME=${PRIMUS_DSV4_TUNABLEOP_FILENAME:-$HERE/tunableop_dsv4_gfx1250_bf16_.csv}

# Triton's async-LDS-copy scheduling miscompiles some Gluon kernels.
export TRITON_HIP_USE_EXPERT_SCHEDULING=${TRITON_HIP_USE_EXPERT_SCHEDULING:-0}
